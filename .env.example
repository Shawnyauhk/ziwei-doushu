# Copy to .env.local. Never use NEXT_PUBLIC_ for server API keys.
# Supported: modelscope, zhipu, gemini.
AI_PROVIDER=modelscope
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# OpenAI-compatible endpoint: https://api-inference.modelscope.cn/v1/
# Keep the Access Token server-side only; account quotas and availability may vary.
MODELSCOPE_API_KEY=your-modelscope-access-token
MODELSCOPE_MODEL=Qwen/Qwen3.5-35B-A3B

# Zhipu standard model API. GLM-4.7-Flash is the verified working model in this project.
ZHIPU_API_KEY=your-zhipu-standard-api-key
ZHIPU_MODEL=glm-4.7-flash

# ─── Billing（Stripe 按次購買）───
# 未同時設定 DATABASE_URL 與 STRIPE_SECRET_KEY 時，AI 解讀維持免費（方便本地開發）。
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# 在 Stripe 後台建立「一次性付款」Price，填入 Price ID
STRIPE_PRICE_SINGLE=price_xxx
STRIPE_PRICE_PACK5=price_xxx

# ─── Site ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
